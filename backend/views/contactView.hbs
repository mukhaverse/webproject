<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>New Contact Message</title>
</head>

<body style="margin:0; padding:0; background:#ffffff; font-family: Arial, sans-serif; color:#1f2f55;">

  <div style="max-width:700px; margin:0 auto; padding:45px 35px;">

    <div style="text-align:center; margin-bottom:28px;">
      <img src="cid:mail@medixa" alt="MEDIXA" style="width:300px; max-width:90%; display:block; margin:0 auto 18px;">
      <h1 style="margin:0; font-size:28px; font-weight:400; color:#111111;">
        New Contact Message
      </h1>
    </div>

    <h2 style="font-size:26px; margin:30px 0 12px; color:#21356f;">
      User Information
    </h2>

    <div style="background:#f4f4f4; border-radius:20px; padding:30px 38px; color:#566078; font-size:14px; line-height:1.35;">
      <p style="margin:0;"><strong>First Name:</strong> {{firstName}}</p>
      <p style="margin:0;"><strong>Last Name:</strong> {{lastName}}</p>
      <p style="margin:0;"><strong>Email:</strong> {{email}}</p>
      <p style="margin:0;"><strong>Phone:</strong> {{phoneNumber}}</p>
      <p style="margin:0;"><strong>Language:</strong> {{language}}</p>
      <p style="margin:0;"><strong>Gender:</strong> {{gender}}</p>
      <p style="margin:0;"><strong>Date of Birth:</strong> {{contactDate}}</p>
    </div>

    <h2 style="font-size:26px; margin:38px 0 12px; color:#21356f;">
      Message
    </h2>

    <div style="background:#f4f4f4; border-radius:20px; padding:30px 38px; color:#566078; font-size:14px; line-height:1.6;">
      {{message}}
    </div>

  </div>

</body>
</html>