<div style="font-family:Arial,sans-serif;padding:40px;background:#f4f7fb;">

  <div style="
    max-width:700px;
    margin:auto;
    background:white;
    border-radius:24px;
    padding:35px;
  ">

    <img
    src="cid:mail@medixa"
    width="90"
    />

    <h1 style="color:#1f2b6c;">
      Suggested Medication Schedule
    </h1>

    <p style="
      color:#5b6475;
      line-height:1.7;
    ">
      {{message}}
    </p>

    <table style="
      width:100%;
      border-collapse:collapse;
      margin-top:25px;
    ">
      {{{rows}}}
    </table>

  </div>
</div>